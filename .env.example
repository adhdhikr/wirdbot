DISCORD_TOKEN=your_bot_token_here
OPENROUTER_API_KEY=sk-or-v1-...
# The model that answers everything, images included (OpenRouter slug)
#AI_MODEL=qwen/qwen3-vl-8b-instruct
# Reasoning effort: none | low | medium | high
#AI_REASONING=low
# Context limits
#AI_MAX_CONTEXT_TOKENS=48000
#AI_MAX_TOOL_RESULT_CHARS=12000
#AI_MAX_ATTACHMENT_CHARS=20000
#AI_MAX_IMAGES=4
# Model for the analyze_image tool (defaults to AI_MODEL)
#AI_VISION_MODEL=qwen/qwen3-vl-8b-instruct

# Optional: route each message to a small or big model instead of using one
#AI_ROUTING_ENABLED=false
#AI_COMPLEX_MODEL=deepseek/deepseek-v4-pro
#AI_SIMPLE_MODEL=qwen/qwen3.7-flash
#AI_ROUTER_MODEL=qwen/qwen3.7-flash
#AI_COMPLEX_REASONING=high
#AI_SIMPLE_REASONING=low
API_BASE_URL=http://api:5000

DEBUG_MODE=false
DEBUG_GUILD_IDS=your_guild_id_for_testing,another_guild_id
